# Local dev only -- copy to .env and fill in real values as they're
# provisioned (Pre-Cycle 0's external-accounts signups). Never commit .env
# itself (see .gitignore).

# --- app/web ---
QSPACE_API_URL=http://localhost:3001
# The document engine (Canvas). Server-side only, never sent to the browser. A RENDER-ONLY token:
# it can render and validate documents and nothing else. Ask whoever runs Canvas for one.
CANVAS_URL=https://canvas.acexoft.com
CANVAS_RENDER_TOKEN=
# Scoped, short-lived, audience-restricted token the web BFF presents to
# the engine (canon D-010). BB26091205 owns minting it; until then the
# route handlers send no Authorization header at all rather than
# forwarding a creator session.
QSPACE_API_TOKEN=
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- app/api ---
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/qspacepress_dev
REDIS_URL=redis://localhost:6380
JWT_SECRET=
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# S3-API object storage -- MinIO locally (self-hosted, no account/card
# needed), same env shape works against Cloudflare R2 later since both
# speak the S3 API (BB26090903's explicit design point). MinIO's own
# default dev credentials below match docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=qspacepress-media
