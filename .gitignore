# Monorepo root .gitignore -- app/mobile/.gitignore covers the Flutter
# app's own build artifacts (root-anchored patterns, kept scoped to where
# Flutter actually lives now). This file covers app/web (Next.js),
# app/api (Rust), and repo-wide tooling/OS/editor junk.

# Node / pnpm (app/web, packages/shared)
node_modules/
.pnpm-store/
.next/
out/
dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Rust (app/api) -- Cargo.lock is deliberately NOT ignored: app/api is a
# binary crate (a deployed service), not a library, so the lockfile is
# committed for reproducible builds, same convention as pnpm-lock.yaml.
target/

# Env / secrets -- never committed, per CLAUDE.md's key-only secret-handling rule
.env
.env.local
.env.*.local

# Docker
*.pid

# Editors / OS
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# Logs
*.log
_next/
